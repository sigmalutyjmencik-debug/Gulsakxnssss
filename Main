MainScale.Scale = 0.55
MainScale.Parent = Main

MakeStroke(Main, 1.5)

local function CenterMain()
    local c = WS.CurrentCamera
    if not c then return end
    local vp = c.ViewportSize
    local sc = MainScale.Scale
    local w = Main.Size.X.Offset * sc
    local h = Main.Size.Y.Offset * sc
    local x = (vp.X - w) / 2
    local y = (vp.Y - h) / 2
    Main.Position = UDim2.fromOffset(x, y)
end
CenterMain()

