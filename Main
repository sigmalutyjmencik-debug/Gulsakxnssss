    local inline = Instance.new("Frame")
    inline.Size = UDim2.fromScale(1, 1)
    inline.BackgroundTransparency = 1
    inline.BorderSizePixel = 0
    inline.Parent = holder

    local inStroke = Instance.new("UIStroke", inline)
    inStroke.Color = S.ESP_Color
    inStroke.Thickness = 1

    local name = Instance.new("TextLabel")
    name.AnchorPoint = V2(0.5, 1)
    name.Position = UDim2.new(0.5, 0, 0, -3)
    name.AutomaticSize = Enum.AutomaticSize.XY
    name.Size = UDim2.fromOffset(0, 0)
    name.BackgroundTransparency = 1
    name.TextColor3 = WHITE
    name.Font = Enum.Font.Code
    name.TextSize = 12
    name.TextStrokeTransparency = 0.4
    name.Text = plr.DisplayName
    name.Parent = holder

    local dist = Instance.new("TextLabel")
