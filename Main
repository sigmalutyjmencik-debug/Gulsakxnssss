-- ===== УТИЛИТЫ UI =====
local function stroke(o,c,t)
    local s=Instance.new("UIStroke"); s.Color=c or BLUE; s.Thickness=t or 1; s.Parent=o; return s
end
local function mkLabel(p,t,x,y,w,h,sz,col)
    local l=Instance.new("TextLabel")
    l.Position=UDim2.new(0,x,0,y); l.Size=UDim2.new(0,w,0,h)
    l.BackgroundTransparency=1; l.Text=t or ""; l.TextColor3=col or WHITE
    l.Font=Enum.Font.Code; l.TextSize=sz or 13
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=p; return l
end
local function div(p,y,c)
    local d=Instance.new("Frame"); d.Size=UDim2.new(1,0,0,1); d.Position=UDim2.new(0,0,0,y)
    d.BackgroundColor3=c or BLUE; d.BorderSizePixel=0; d.Parent=p
end

-- ===== CHARACTER TRACK =====
do
    F.char=LP.Character
    F.hum=F.char and F.char:FindFirstChildWhichIsA("Humanoid")
    local function upd(c)
        F.char=c; F.hum=nil
        if c then
            local h=c:FindFirstChildWhichIsA("Humanoid")
            if h then F.hum=h else spawn(function() local h2=c:WaitForChild("Humanoid",15); if h2 and F.char==c then F.hum=h2 end end) end
        end
    end
    F.conns[#F.conns+1]=LP.CharacterAdded:Connect(upd)
    F.conns[#F.conns+1]=LP.CharacterRemoving:Connect(function() F.char=nil; F.hum=nil end)
    if F.char then upd(F.char) end
    for _,p in ipairs(Players:GetPlayers()) do if p~=LP then F.playerCache[p]=true end end
    F.conns[#F.conns+1]=Players.PlayerAdded:Connect(function(p) if p~=LP then F.playerCache[p]=true end end)
    F.conns[#F.conns+1]=Players.PlayerRemoving:Connect(function(p) F.playerCache[p]=nil end)
end

local function isTeammate(p)
    if not S.Team.Enabled or not p or p==LP then return false end
    if S.Team.Teammates[p.UserId] then return true end
    return S.Team.SelectedNames[p.Name] or S.Team.SelectedNames[p.DisplayName]
end

