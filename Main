-- AIM
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function getIgnoreList()
    local list = { LP.Character, WS.CurrentCamera }
    for plr in next, F.playerCache do
        if plr.Character then
            table.insert(list, plr.Character)
        end
    end
    return list
end

F.pointVisible = function(character, worldPoint)
    local c = WS.CurrentCamera
    if not c then return false end
    local origin = c.CFrame.Position
    rayParams.FilterDescendantsInstances = getIgnoreList()
    local direction = worldPoint - origin
    if direction.Magnitude <= 0.01 then
        return true
    end
    local result = WS:Raycast(origin, direction, rayParams)
    if not result then
        return true
    end
    local inst = result.Instance
    if inst and inst:IsDescendantOf(character) then
        return true
    end
    return false
end

F.getClosestSA = function()
    local closestPart = nil
    local closestPos = nil
    local bestScore = math.huge
    local c = WS.CurrentCamera
    if not c then return nil, nil end
    local vp = c.ViewportSize
    local fovOrigin = V2(vp.X * 0.5, vp.Y * 0.5)
    local myRoot = F.char and F.char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil end
    local myPos = myRoot.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and not F.isTeammate(player) then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health > 0 then
                    local part = char:FindFirstChild(S.SA_TargetPart)
                    if not part then part = char:FindFirstChild("Head") end
                    if not part then part = char:FindFirstChild("HumanoidRootPart") end
                    if part then
                        local dist = (part.Position - myPos).Magnitude
                        if dist <= S.SA_MaxDistance then
                            if not S.SA_VisibleCheck or F.pointVisible(char, part.Position) then
                                local sp, onScreen = c:WorldToViewportPoint(part.Position)
                                if onScreen then
                                    local fovDist = (fovOrigin - V2(sp.X, sp.Y)).Magnitude
                                    if fovDist <= S.SA_FOVRadius then
                                        local score = dist
                                        if S.SA_TargetMode == "Cursor" then
                                            score = fovDist
                                        end
                                        if score < bestScore then
                                            bestScore = score
                                            closestPart = part
                                            closestPos = part.Position
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPart, closestPos
end

-- HOOKS (safe)
pcall(function()
    local old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and S.SA_Enabled and F.targetPos then
            if math.random(1, 100) <= S.SA_HitChance then
                local args = table.pack(...)
                for i = 1, args.n do
                    local a = args[i]
                    if typeof(a) == "Vector3" then
                        args[i] = F.targetPos
                    elseif typeof(a) == "CFrame" then
                        args[i] = CF.new(F.targetPos)
                    end
                end
                return old(self, unpack(args, 1, args.n))
            end
        end
        return old(self, ...)
    end))
end)

pcall(function()
    local okGun, GunBase = pcall(function()
        return require(RS:WaitForChild("Gun"):WaitForChild("Scripts"):WaitForChild("GunBase"))
    end)
    if okGun and type(GunBase) == "table" and GunBase.fire then
        local origFire = GunBase.fire
        GunBase.fire = function(self, ...)
            if S.SA_Enabled and F.targetPos then
                local args = table.pack(...)
                local patched = false
                local pos = F.targetPos
                for i = 1, args.n do
                    local v = args[i]
                    if typeof(v) == "Vector3" and not patched then
                        args[i] = pos
                        patched = true
                    elseif typeof(v) == "buffer" and not patched then
                        pcall(function()
                            buffer.writef32(v, 4, pos.X)
                            buffer.writef32(v, 8, pos.Y)
                            buffer.writef32(v, 12, pos.Z)
                        end)
                        patched = true
                    end
                end
                if patched then
                    return origFire(self, unpack(args, 1, args.n))
                end
            end
            return origFire(self, ...)
        end
    end
end)

