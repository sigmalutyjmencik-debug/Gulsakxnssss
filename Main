    Rust = "rbxassetid://5043539486",
    Metal = "rbxassetid://8917041751",
    Skeet = "rbxassetid://83717596220569",
    Quack = "rbxassetid://6435400690",
    Katana = "rbxassetid://7122613461",
    Neverlose = "rbxassetid://18391691942",
    Undertale = "rbxassetid://1471213022",
    ["Jet Set Radio"] = "rbxassetid://97113622160405",
    ["TF2 Critical"] = "rbxassetid://8255306220",
    ["TF2 Frying Pan"] = "rbxassetid://18922477538",
    ["TF2 Alternative"] = "rbxassetid://2868331684",
}

F.applyHitSound = function()
    if not S.HitSound_Enabled then return end
    local id = HitSoundList[S.HitSound_Choice]
    if not id or id == "" then return end
    local ch = F.char
    if not ch then return end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("Sound") then
            local n = string.lower(d.Name)
            if string.find(n, "hit") or string.find(n, "shot") then
                if not S.HitSound_Originals[d] then
                    S.HitSound_Originals[d] = { SoundId = d.SoundId, Volume = d.Volume }
                end
                d.SoundId = id
                d.Volume = S.HitSound_Volume
            end
        end
    end
end

