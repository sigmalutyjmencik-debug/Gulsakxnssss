local PickerCallback = nil
local PickerPreview = nil
local HueValue = 0
local Saturation = 1
local Brightness = 1
local PendingColor = ACCENT
local PaletteDragging = false
local HueDragging = false

local function UpdatePicker()
    Palette.BackgroundColor3 = Color3.fromHSV(HueValue, 1, 1)
    PendingColor = Color3.fromHSV(HueValue, Saturation, Brightness)
    PaletteCursor.Position = UDim2.new(Saturation, 0, 1 - Brightness, 0)
    HueCursor.Position = UDim2.new(0.5, 0, HueValue, 0)
    local r = floor(PendingColor.R * 255 + 0.5)
    local g = floor(PendingColor.G * 255 + 0.5)
    local b = floor(PendingColor.B * 255 + 0.5)
    RGBLabel.Text = string.format("RGB: %d, %d, %d", r, g, b)
end

local function LoadColor(c)
    local h, s, v = c:ToHSV()
    HueValue = h
    Saturation = s
    Brightness = v
    PendingColor = c
    UpdatePicker()
end

local function UpdatePaletteFromInput(input)
    local p = Palette.AbsolutePosition
    local s = Palette.AbsoluteSize
    Saturation = clamp((input.Position.X - p.X) / s.X, 0, 1)
    Brightness = 1 - clamp((input.Position.Y - p.Y) / s.Y, 0, 1)
    UpdatePicker()
end

local function UpdateHueFromInput(input)
    local p = Hue.AbsolutePosition
    local s = Hue.AbsoluteSize
    HueValue = clamp((input.Position.Y - p.Y) / s.Y, 0, 1)
    UpdatePicker()
end

Palette.InputBegan:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        PaletteDragging = true
        UpdatePaletteFromInput(input)
    end
end)

Hue.InputBegan:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        HueDragging = true
        UpdateHueFromInput(input)
    end
end)

UIS.InputChanged:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
        if PaletteDragging then
            UpdatePaletteFromInput(input)
        end
        if HueDragging then
            UpdateHueFromInput(input)
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        PaletteDragging = false
        HueDragging = false
    end
end)

local function OpenPicker(preview, currentColor, callback)
    PickerCallback = callback
    PickerPreview = preview
    LoadColor(currentColor)
    local p = preview.AbsolutePosition
    local s = preview.AbsoluteSize
    local c = WS.CurrentCamera
    if not c then return end
    local vp = c.ViewportSize
    local x = p.X + s.X + 12
    local y = p.Y - 45
    if x + 160 > vp.X then
        x = p.X - 170
    end
    if y + 155 > vp.Y then
        y = vp.Y - 160
    end
    if x < 5 then x = 5 end
    if y < 5 then y = 5 end
    Picker.Position = UDim2.fromOffset(x, y)
    Picker.Visible = true
end

ApplyButton.MouseButton1Click:Connect(function()
    if PickerCallback then
        local ok, err = pcall(PickerCallback, PendingColor)
    end
    if PickerPreview and PickerPreview.Parent then
        PickerPreview.BackgroundColor3 = PendingColor
    end
    Picker.Visible = false
end)

-- CONTROLS
local function CreateSection(holder, title)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 24)
    r.BackgroundTransparency = 1
    r.Parent = holder
    MakeText(r, title, UDim2.fromOffset(2, 0), UDim2.new(1, -4, 1, 0), 13, ACCENT)
    MakeLine(r, 22)
end

local function CreateLabel(holder, text)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 18)
    r.BackgroundTransparency = 1
    r.Parent = holder
    MakeText(r, text, UDim2.fromOffset(2, 0), UDim2.new(1, -4, 1, 0), 11, GRAY)
end

local function CreateToggle(holder, name, default, callback)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 24)
    r.BackgroundTransparency = 1
    r.Parent = holder

    local box = Instance.new("TextButton")
    box.Position = UDim2.fromOffset(2, 4)
    box.Size = UDim2.fromOffset(16, 16)
    box.BackgroundColor3 = CHECKBG
    box.BorderSizePixel = 0
    box.Text = ""
    box.AutoButtonColor = false
    box.Parent = r
    MakeStroke(box, 1)

    local fill = Instance.new("Frame")
    fill.Position = UDim2.fromOffset(3, 3)
    fill.Size = UDim2.fromOffset(10, 10)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.Visible = default
    fill.Parent = box

    MakeText(r, name, UDim2.fromOffset(24, 0), UDim2.new(1, -28, 1, 0), 13, WHITE)

    local state = default

    box.MouseButton1Click:Connect(function()
        state = not state
        fill.Visible = state
        if callback then
            pcall(callback, state)
        end
    end)
end

local function CreateSlider(holder, name, mn, mx, default, rounding, callback)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 40)
    r.BackgroundTransparency = 1
    r.Parent = holder

    MakeText(r, name, UDim2.fromOffset(2, 0), UDim2.new(1, -60, 0, 16), 13, WHITE)

    local vl = MakeText(r, tostring(default), UDim2.new(1, -56, 0, 0), UDim2.fromOffset(52, 16), 13, ACCENT)
    vl.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(2, 20)
    bar.Size = UDim2.new(1, -4, 0, 10)
    bar.BackgroundColor3 = BARBG
    bar.BorderSizePixel = 0
    bar.Parent = r
    MakeStroke(bar, 1)

    local ratio = (default - mn) / (mx - mn)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = bar

    local dragging = false

    local function update(input)
        local pos = bar.AbsolutePosition
        local size = bar.AbsoluteSize
        local rel = clamp((input.Position.X - pos.X) / size.X, 0, 1)
        local v = mn + (mx - mn) * rel
        if rounding then
            local m = 10 ^ rounding
            v = floor(v * m + 0.5) / m
        end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        vl.Text = tostring(v)
        if callback then
            pcall(callback, v)
        end
    end

    btn.InputBegan:Connect(function(i)
        local t = i.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragging = true
            update(i)
        end
    end)

    UIS.InputChanged:Connect(function(i)
        local t = i.UserInputType
        if dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
            update(i)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        local t = i.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function CreateDropdown(holder, name, values, default, callback)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 52)
    r.BackgroundTransparency = 1
    r.ClipsDescendants = false
    r.Parent = holder

    MakeText(r, name, UDim2.fromOffset(2, 0), UDim2.new(1, -4, 0, 16), 12, GRAY)

    local box = Instance.new("Frame")
    box.Position = UDim2.fromOffset(2, 18)
    box.Size = UDim2.new(1, -4, 0, 26)
    box.BackgroundColor3 = DROPBG
    box.BorderSizePixel = 0
    box.ZIndex = 20
    box.Parent = r
    MakeStroke(box, 1)

    local current = default
    if not current then current = values[1] end

    local tx = MakeText(box, tostring(current), UDim2.fromOffset(6, 0), UDim2.new(1, -30, 1, 0), 12, WHITE)
    tx.ZIndex = 21

    local ar = MakeText(box, "v", UDim2.new(1, -22, 0, 0), UDim2.fromOffset(16, 26), 11, WHITE)
    ar.TextXAlignment = Enum.TextXAlignment.Center
    ar.ZIndex = 21

    local list = Instance.new("Frame")
    list.Position = UDim2.fromOffset(0, 27)
    list.Size = UDim2.new(1, 0, 0, #values * 22)
    list.BackgroundColor3 = DROPBG
    list.BorderSizePixel = 0
    list.Visible = false
    list.ZIndex = 100
    list.Parent = box
    MakeStroke(list, 1)

    for i = 1, #values do
        local v = values[i]
        local ob = Instance.new("TextButton")
        ob.Position = UDim2.fromOffset(0, (i - 1) * 22)
        ob.Size = UDim2.new(1, 0, 0, 22)
        ob.BackgroundTransparency = 1
        ob.Text = "  " .. tostring(v)
        ob.TextColor3 = WHITE
        ob.Font = Enum.Font.Code
        ob.TextSize = 12
        ob.TextXAlignment = Enum.TextXAlignment.Left
        ob.AutoButtonColor = false
        ob.ZIndex = 101
        ob.Parent = list
        ob.MouseButton1Click:Connect(function()
            current = v
            tx.Text = tostring(v)
            list.Visible = false
            if callback then
                pcall(callback, v)
            end
        end)
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 25
    btn.Parent = box
    btn.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
    end)
end

local function CreateColor(holder, name, default, callback)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 24)
    r.BackgroundTransparency = 1
    r.Parent = holder

    MakeText(r, name, UDim2.fromOffset(2, 0), UDim2.new(1, -30, 1, 0), 13, WHITE)

    local sw = Instance.new("TextButton")
    sw.AnchorPoint = V2(1, 0)
    sw.Position = UDim2.new(1, -2, 0, 3)
    sw.Size = UDim2.fromOffset(18, 18)
    sw.BackgroundColor3 = default
    sw.BorderSizePixel = 0
    sw.Text = ""
    sw.AutoButtonColor = false
    sw.ZIndex = 10
    sw.Parent = r

    local swCorner = Instance.new("UICorner")
    swCorner.CornerRadius = UDim.new(0, 3)
    swCorner.Parent = sw
    MakeStroke(sw, 1)

    sw.MouseButton1Click:Connect(function()
        OpenPicker(sw, sw.BackgroundColor3, function(c)
            sw.BackgroundColor3 = c
            if callback then
                pcall(callback, c)
            end
        end)
    end)
end

