    dist.TextStrokeTransparency = 0.4
    dist.Text = ""
    dist.Parent = holder

    local weapon = Instance.new("TextLabel")
    weapon.AnchorPoint = V2(0.5, 0)
    weapon.Position = UDim2.new(0.5, 0, 1, 16)
    weapon.AutomaticSize = Enum.AutomaticSize.XY
    weapon.Size = UDim2.fromOffset(0, 0)
    weapon.BackgroundTransparency = 1
    weapon.TextColor3 = WHITE
    weapon.Font = Enum.Font.Code
    weapon.TextSize = 10
    weapon.TextStrokeTransparency = 0.4
    weapon.Text = ""
