-- ===== AIM =====
local rayParams=RaycastParams.new(); rayParams.FilterType=Enum.RaycastFilterType.Exclude; rayParams.IgnoreWater=true
local function getIgnoreList()
    local list={LP.Character,cam}
    for p in next,F.playerCache do if p.Character then list[#list+1]=p.Character end end
    return list
end
function F.pointVisible(char,target)
    if not cam then return false end
    local origin=cam.CFrame.Position
    rayParams.FilterDescendantsInstances=getIgnoreList()
    local dir=target-origin
    if dir.Magnitude<=0.01 then return true end
    local r=WS:Raycast(origin,dir,rayParams)
    if not r then return true end
    return r.Instance and r.Instance:IsDescendantOf(char) or false
end

function F.getClosestSA()
    local bestPart,bestPos,bestScore=nil,nil,math.huge
    local vp=cam.ViewportSize; local fovOrigin=V2(vp.X*0.5,vp.Y*0.5)
    local myRoot=F.char and F.char:FindFirstChild("HumanoidRootPart")
    local myPos=myRoot and myRoot.Position or cam.CFrame.Position
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and not isTeammate(p) then
            local ch=p.Character
            if ch then
                local hum=ch:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health>0 then
                    local part=ch:FindFirstChild(S.SA.TargetPart) or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
                    if part then
                        local dist=(part.Position-myPos).Magnitude
                        if dist<=S.SA.MaxDistance then
                            if S.SA.VisibleCheck and not F.pointVisible(ch,part.Position) then
                            else
                                local sp,on=cam:WorldToViewportPoint(part.Position)
                                if on then
                                    local fovDist=(fovOrigin-V2(sp.X,sp.Y)).Magnitude
                                    if fovDist<=S.SA.FOVRadius then
                                        local score=S.SA.TargetMode=="Cursor" and fovDist or dist
                                        if score<bestScore then bestScore=score; bestPart=part; bestPos=part.Position end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart,bestPos
end

function F.getClosestRage()
    local bestPart,bestPos,bestScore=nil,nil,math.huge
    local myRoot=F.char and F.char:FindFirstChild("HumanoidRootPart")
    local myPos=myRoot and myRoot.Position or cam.CFrame.Position
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and not isTeammate(p) then
            local ch=p.Character
            if ch then
                local hum=ch:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health>0 then
                    local part=ch:FindFirstChild(S.Rage.TargetPart) or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
                    if part then
                        local dist=(part.Position-myPos).Magnitude
                        if dist<=S.Rage.MaxDistance then
                            if S.Rage.VisibleCheck and not F.pointVisible(ch,part.Position) then
                            else
                                if dist<bestScore then bestScore=dist; bestPart=part; bestPos=part.Position end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart,bestPos
end

-- ===== HOOK SILENT AIM =====
if hookmetamethod and getnamecallmethod and newcclosure then
    local old
    old=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
        local m=getnamecallmethod()
        if m=="FireServer" and S.SA.Enabled and F.targetPos then
            if math.random(1,100)<=(S.SA.HitChance or 100) then
                local a=table.pack(...)
                for i=1,a.n do
                    local v=a[i]
                    if typeof(v)=="Vector3" then a[i]=F.targetPos
                    elseif typeof(v)=="CFrame" then a[i]=CF.new(F.targetPos) end
                end
                return old(self,unpack(a,1,a.n))
            end
        elseif m=="Raycast" and self==WS then
            if checkcaller() then return old(self,...) end
            local origin,dir,rp=...
            if typeof(origin)=="Vector3" and typeof(dir)=="Vector3" then
                if S.SA.Enabled and F.targetPos then
                    local mag=dir.Magnitude
                    local no=S.Manipulation and cam.CFrame.Position or origin
                    local nd=(F.targetPos-no).Unit*mag
                    return old(self,no,nd,rp)
                end
            end
        end
        return old(self,...)
    end))
end

-- ===== ESP =====
local espGui=Instance.new("ScreenGui"); espGui.Name="VomESP"; espGui.ResetOnSpawn=false
espGui.IgnoreGuiInset=true; pcall(function() espGui.Parent=CoreGui end)
local espCache={}

local function mkESP(plr)
    local holder=Instance.new("Frame"); holder.BackgroundTransparency=1; holder.Visible=false; holder.Parent=espGui
    local box=Instance.new("Frame"); box.Size=UDim2.fromScale(1,1); box.BackgroundTransparency=1
    box.BorderSizePixel=0; box.Parent=holder
    local outer=stroke(box,BLACK or Color3.new(0,0,0),2)
    local inline=Instance.new("Frame"); inline.Size=UDim2.fromScale(1,1); inline.BackgroundTransparency=1
    inline.BorderSizePixel=0; inline.Parent=holder
    local ilStroke=stroke(inline,S.ESPColors.Box,1)
    local name=mkLabel(holder,plr.DisplayName,0,0,10,10,12,WHITE); name.AnchorPoint=V2(0.5,1)
    name.Position=UDim2.new(0.5,0,0,-4); name.AutomaticSize=Enum.AutomaticSize.XY; name.Size=UDim2.fromOffset(0,0)
    local dist=mkLabel(holder,"0",0,0,10,10,10,WHITE); dist.AnchorPoint=V2(0.5,0)
    dist.Position=UDim2.new(0.5,0,1,3); dist.AutomaticSize=Enum.AutomaticSize.XY; dist.Size=UDim2.fromOffset(0,0)
    local hpBg=Instance.new("Frame"); hpBg.AnchorPoint=V2(1,0); hpBg.Position=UDim2.new(0,-4,0,0)
    hpBg.Size=UDim2.new(0,4,1,0); hpBg.BackgroundColor3=Color3.fromRGB(10,10,10)
    hpBg.BorderSizePixel=0; hpBg.Visible=false; hpBg.Parent=holder; stroke(hpBg,Color3.new(0,0,0),1)
    local hp=Instance.new("Frame"); hp.AnchorPoint=V2(0,1); hp.Position=UDim2.new(0,0,1,0)
    hp.Size=UDim2.new(1,0,1,0); hp.BackgroundColor3=Color3.fromRGB(0,255,0); hp.BorderSizePixel=0; hp.Parent=hpBg
    local chams=nil
    espCache[plr]={Holder=holder,Box=box,Inline=ilStroke,Name=name,Dist=dist,HpBg=hpBg,Hp=hp,Chams=chams}
    return espCache[plr]
end

local function rmESP(plr)
    local d=espCache[plr]
    if d then
        pcall(function()
            if d.Chams then d.Chams:Destroy() end
            d.Holder:Destroy()
        end)
        espCache[plr]=nil
    end
end
Players.PlayerRemoving:Connect(rmESP)

function F.updateESP()
    if S.Unloaded then return end
    if not S.ESP.Enabled and not S.Team.Enabled then
        for _,d in pairs(espCache) do d.Holder.Visible=false end
        return
    end
    local myRoot=F.char and F.char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for plr in next,F.playerCache do
        local d=espCache[plr]
        local mate=isTeammate(plr)
        if not S.ESP.Enabled and not mate then
            if d then d.Holder.Visible=false end
        else
            local ch=plr.Character
            local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
            local hum=ch and ch:FindFirstChildWhichIsA("Humanoid")
            if ch and hrp and hum and hum.Health>0 then
                local dist=(myRoot.Position-hrp.Position).Magnitude
                if dist<=S.ESP.MaxDistance then
                    local sp,on=cam:WorldToViewportPoint(hrp.Position)
                    if sp.Z>1 and (on or (sp.X>-80 and sp.X<cam.ViewportSize.X+80 and sp.Y>-80 and sp.Y<cam.ViewportSize.Y+80)) then
                        if not d then d=mkESP(plr) end
                        local vp=cam.ViewportSize
                        local proj=vp.Y/(2*math.tan(rad(cam.FieldOfView)*0.5))
                        local h=clamp((7*proj)/sp.Z,5,vp.Y*0.82)
                        local w=math.max(h*0.6,3)
                        d.Holder.Visible=true
                        d.Holder.Position=UDim2.fromOffset(floor(sp.X-w*0.5),floor(sp.Y-h*0.52))
                        d.Holder.Size=UDim2.fromOffset(floor(w),floor(h))
                        local col=mate and S.Team.Color or S.ESPColors.Box
                        d.Box.Visible=S.ESP.Box or mate
                        d.Inline.Color=col
                        d.Name.Visible=S.ESP.Name or mate
                        d.Name.Text=plr.DisplayName
                        d.Dist.Visible=S.ESP.Distance
                        d.Dist.Text=floor(dist).."m"
                        d.HpBg.Visible=S.ESP.HealthBar
                        if S.ESP.HealthBar then d.Hp.Size=UDim2.new(1,0,clamp(hum.Health/hum.MaxHealth,0,1),0) end
                        if S.ESP.Chams then
                            if not d.Chams or not d.Chams.Parent then
                                local hl=Instance.new("Highlight"); hl.Adornee=ch
                                hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                                hl.FillTransparency=1-clamp(S.ESP.ChamsStrength/100,0,1)
                                hl.FillColor=col; hl.OutlineColor=col; hl.OutlineTransparency=0.3; hl.Parent=ch
                                d.Chams=hl
                            end
                        elseif d.Chams then d.Chams:Destroy(); d.Chams=nil end
                    else
                        if d then d.Holder.Visible=false end
                    end
                else
                    if d then d.Holder.Visible=false end
                end
            else
                if d then d.Holder.Visible=false end
            end
        end
    end
end

-- ===== HITBOX =====
local enlarged={}
function F.RestoreAllHitboxes()
    for obj,orig in pairs(enlarged) do
        if obj and obj.Parent then
            obj.Size=orig.Size; obj.Color=orig.Color; obj.Transparency=orig.Transparency; obj.Material=orig.Material
        end
    end
    enlarged={}
end
function F.UpdateAllHitboxes()
    for obj,orig in pairs(enlarged) do
        if obj and obj.Parent then
            obj.Size=orig.Size*S.Hitbox.Size; obj.Color=S.Hitbox.Color; obj.Transparency=S.Hitbox.Transparency
        end
    end
end
function F.ApplyHitboxVisuals()
    for obj in pairs(enlarged) do
        if obj and obj.Parent then obj.Transparency=S.Hitbox.Transparency; obj.Color=S.Hitbox.Color end
    end
end
function F.InitHitboxWatchers()
    task.spawn(function()
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP and p.Character then
                local hb=p.Character:FindFirstChild("HeadHitbox")
                if hb and not enlarged[hb] then
                    enlarged[hb]={Size=hb.Size,Color=hb.Color,Transparency=hb.Transparency,Material=hb.Material}
                    if S.Hitbox.Enabled then
                        hb.Size=hb.Size*S.Hitbox.Size; hb.Color=S.Hitbox.Color
                        hb.Transparency=S.Hitbox.Transparency; hb.Material=Enum.Material.Neon
                    end
                end
            end
        end
    end)
end

-- ===== TRACERS =====
local tracers={}
function F.createTrace(a,b)
    if S.Unloaded then return end
    local p=Instance.new("Part"); p.Anchored=true; p.CanCollide=false; p.Transparency=1
    p.Size=V3(0.1,0.1,0.1); p.Parent=WS
    local a0=Instance.new("Attachment",p); local a1=Instance.new("Attachment",p)
    a0.WorldPosition=a; a1.WorldPosition=b
    local beam=Instance.new("Beam"); beam.Attachment0=a0; beam.Attachment1=a1
    beam.FaceCamera=true; beam.LightEmission=1; beam.LightInfluence=0
    beam.Texture=S.Tracers.TextureID; beam.TextureLength=2; beam.TextureSpeed=2
    beam.Color=ColorSequence.new(S.Tracers.Color); beam.Width0=S.Tracers.Width; beam.Width1=S.Tracers.Width
    beam.Transparency=NumberSequence.new(S.Tracers.Transparency); beam.Parent=p
    tracers[#tracers+1]={p=p,b=beam,t=tick()}
end
function F.updateTracers()
    for i=#tracers,1,-1 do
        local tr=tracers[i]
        if not tr.p or not tr.p.Parent then table.remove(tracers,i)
        elseif tick()-tr.t>S.Tracers.LifeTime then
            pcall(function() tr.p:Destroy() end); table.remove(tracers,i)
        end
    end
end

-- ===== CROSSHAIR =====
local chLines={}
if DrawingOK then
    for i=1,4 do
        local l=Drawing.new("Line"); l.Visible=false; l.Thickness=S.CH.Thickness; l.Color=S.CH.Color; chLines[i]=l
    end
end
function F.updateCrosshair(dt)
    if not DrawingOK then return end
    if not S.CH.Enabled or S.Unloaded then
        for _,l in ipairs(chLines) do l.Visible=false end
        return
    end
    local vp=cam.ViewportSize
    local cx,cy=vp.X*0.5,vp.Y*0.5
    local col=S.CH.Color
    for i=0,3 do
        local l=chLines[i+1]
        local ang=rad(i*90)
        local dx,dy=cos(ang),sin(ang)
        l.Visible=true; l.Color=col
        l.From=V2(cx+dx*S.CH.Gap,cy+dy*S.CH.Gap)
        l.To=V2(cx+dx*(S.CH.Gap+S.CH.Length),cy+dy*(S.CH.Gap+S.CH.Length))
    end
end

-- ===== DAMAGE FX =====
function F.spawnDamageFX(pos,scale)
    if S.Unloaded or not S.DamageFX.Enabled then return end
    scale=scale or 1
    local p=Instance.new("Part"); p.Size=V3(0.2,0.2,0.2); p.Transparency=1
    p.Anchored=true; p.CanCollide=false; p.CanQuery=false; p.Position=pos+V3(0,1,0); p.Parent=WS
    local att=Instance.new("Attachment",p)
    local e=Instance.new("ParticleEmitter"); e.Enabled=false
    e.Color=ColorSequence.new(S.DamageFX.Color)
    e.Lifetime=NumberRange.new(S.DamageFX.Lifetime)
    e.Speed=NumberRange.new(S.DamageFX.Speed)
    e.SpreadAngle=V2(360,-360); e.Rate=100
    e.Size=NumberSequence.new({
        NumberSequenceKeypoint.new(0,0),
        NumberSequenceKeypoint.new(0.5,S.DamageFX.Size*4),
        NumberSequenceKeypoint.new(1,0)
    })
    e.Transparency=NumberSequence.new({
        NumberSequenceKeypoint.new(0,0),
        NumberSequenceKeypoint.new(1,1)
    })
    e.Texture="rbxassetid://8297030850"; e.Parent=att
    e:Emit(math.max(1,floor(S.DamageFX.Count*scale)))
    Debris:AddItem(p,S.DamageFX.Lifetime+1.2)
end

-- ===== MOVEMENT/FLY/SPIN =====
function F.toggleCopterFly()
    local hum=F.hum
    if S.CopterFly.Enabled then
        S.CopterFly.Enabled=false
        if S.CopterFly.bodyVel then pcall(function() S.CopterFly.bodyVel:Destroy() end); S.CopterFly.bodyVel=nil end
        if S.CopterFly.bodyGyro then pcall(function() S.CopterFly.bodyGyro:Destroy() end); S.CopterFly.bodyGyro=nil end
        if hum then hum.AutoRotate=true end
        return
    end
    if hum and hum.SeatPart then
        S.CopterFly.Enabled=true; hum.AutoRotate=false
        local target=hum.SeatPart
        local bv=Instance.new("BodyVelocity",target); bv.MaxForce=V3(1,1,1)*9e9; bv.Velocity=V3(0,0,0)
        local bg=Instance.new("BodyGyro",target); bg.MaxTorque=V3(1,1,1)*9e9; bg.P=9000; bg.CFrame=target.CFrame
        S.CopterFly.bodyVel=bv; S.CopterFly.bodyGyro=bg
    end
end
function F.disableCopterFly()
    if S.CopterFly.bodyVel then pcall(function() S.CopterFly.bodyVel:Destroy() end); S.CopterFly.bodyVel=nil end
    if S.CopterFly.bodyGyro then pcall(function() S.CopterFly.bodyGyro:Destroy() end); S.CopterFly.bodyGyro=nil end
    local hum=F.hum; if hum then hum.AutoRotate=true end
    S.CopterFly.Enabled=false
end
function F.copterFlyStep(hum)
    if not hum or not hum.SeatPart then F.disableCopterFly(); return end
    local target=hum.SeatPart
    local mv=V3(0,0,0); local cf=cam.CFrame
    if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+cf.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-cf.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+cf.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-cf.RightVector end
    local vert=0
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vert=1 end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vert=-1 end
    hum.Sit=true
    if S.CopterFly.bodyVel and S.CopterFly.bodyVel.Parent==target then
        if mv.Magnitude>0 or vert~=0 then
            S.CopterFly.bodyVel.Velocity=(mv+V3(0,vert,0)).Unit*S.CopterFly.Speed
        else
            S.CopterFly.bodyVel.Velocity=V3(0,0,0)
        end
    end
    if S.CopterFly.bodyGyro and S.CopterFly.bodyGyro.Parent==target then
        S.CopterFly.bodyGyro.CFrame=cf
    end
end

-- ===== MAIN LOOP =====
local spRay=RaycastParams.new(); spRay.FilterType=Enum.RaycastFilterType.Exclude; spRay.IgnoreWater=true
RunService.Heartbeat:Connect(function(dt)
    if S.Unloaded then return end
    F.updateTracers()
    local ch=F.char
    if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    local hum=F.hum
    if not hrp or not hum or hum.Health<=0 then return end
    if S.Speed.Enabled then
        local md=hum.MoveDirection
        if md.Magnitude>0 then hrp.AssemblyLinearVelocity=V3(md.X*S.Speed.Value,hrp.AssemblyLinearVelocity.Y,md.Z*S.Speed.Value) end
    end
    if S.CopterSpeed.Enabled and hum.Sit then
        local md=hum.MoveDirection
        if md.Magnitude>0 then hrp.AssemblyLinearVelocity=V3(md.X*S.CopterSpeed.Value,hrp.AssemblyLinearVelocity.Y,md.Z*S.CopterSpeed.Value) end
    end
    if S.WaterSpeed.Enabled then
        if hum:GetState()==Enum.HumanoidStateType.Swimming then
            local bv=hrp:FindFirstChild("WSV")
            if not bv then bv=Instance.new("BodyVelocity",hrp); bv.Name="WSV"; bv.MaxForce=V3(1e5,1e5,1e5) end
            bv.Velocity=hum.MoveDirection*S.WaterSpeed.Value
        else
            local bv=hrp:FindFirstChild("WSV"); if bv then bv:Destroy() end
        end
    end
    if S.Spider.Enabled and UIS:IsKeyDown(Enum.KeyCode.W) then
        spRay.FilterDescendantsInstances={ch}
        local r=WS:Raycast(hrp.Position,hrp.CFrame.LookVector*2.5,spRay)
        if r and r.Instance and r.Instance:IsA("BasePart") and r.Instance.CanCollide and abs(r.Normal.Y)<0.5 then
            hrp.AssemblyLinearVelocity=V3(hrp.AssemblyLinearVelocity.X,S.Spider.Speed,hrp.AssemblyLinearVelocity.Z)
        end
    end
    if S.CopterFly.Enabled then F.copterFlyStep(hum) end
    if S.Spinner.Enabled then
        hum.AutoRotate=false
        hrp.CFrame=hrp.CFrame*CFrame.Angles(0,rad(S.Spinner.Speed*dt),0)
    end
end)

local nTarget,nESP=0,0
RunService.RenderStepped:Connect(function(dt)
    if S.Unloaded then return end
    local c=WS.CurrentCamera
    if c then cam=c end
    local now=tick()

    if S.ThirdPerson.Enabled then
        local hrp=F.char and F.char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local focus=hrp.Position+V3(0,S.ThirdPerson.Height,0)
            local look=cam.CFrame.LookVector
            cam.CFrame=CFrame.lookAt(focus-look*S.ThirdPerson.Distance,focus)
        end
    end
    if S.FOVCam.Enabled then cam.FieldOfView=S.FOVCam.Value end

    if F.aimEnabled and F.aimEnabled() then
    else
        if S.SA.Enabled or S.Rage.Enabled then
            if now>=nTarget then
                nTarget=now+0.01
                local part,pos
                if S.Rage.Enabled then part,pos=F.getClosestRage() else part,pos=F.getClosestSA() end
                F.targetPart=part; F.targetPos=pos
            end
        else
            F.targetPart=nil; F.targetPos=nil
        end
    end

    if F.targetPos then
        local sp=cam:WorldToViewportPoint(F.targetPos)
        F.aimScreenPos=sp and V2(sp.X,sp.Y) or nil
    else
        F.aimScreenPos=nil
    end

    if S.SA.ShowFOV and S.SA.Enabled then
        fovFill.Visible=true
        local vp=cam.ViewportSize
        fovFill.Position=UDim2.new(0,vp.X*0.5,0,vp.Y*0.5)
        fovFill.Size=UDim2.new(0,S.SA.FOVRadius*2,0,S.SA.FOVRadius*2)
        local col=F.targetPart and Color3.fromRGB(255,0,0) or WHITE
        fovFill.BackgroundColor3=col; fovStroke.Color=col
    else
        fovFill.Visible=false
    end

    F.updateCrosshair(dt)
    if now>=nESP then nESP=now+0.016; F.updateESP() end
end)

-- ===== INPUT =====
UIS.InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.UserInputType==Enum.UserInputType.MouseButton1 then
        if S.SA.Enabled and F.targetPart then
            local plr=F.targetPart.Parent and Players:GetPlayerFromCharacter(F.targetPart.Parent)
            if plr then F.lastConfirmedShotPlayer=plr; F.lastConfirmedShotTime=clock() end
        end
    end
end)

-- ===== KILL SOUNDS =====
local killTimes={}
function F.playKillSound()
    if not S.KillSound.Enabled then return end
    local now=clock()
    killTimes[#killTimes+1]=now
    for i=#killTimes,1,-1 do if now-killTimes[i]>10 then table.remove(killTimes,i) end end
    local s=Instance.new("Sound"); s.Volume=S.KillSound.Volume; s.Parent=SS
    local KILL_SOUNDS={"6350854289","132050044560917","125662494668382","130940311850179"}
    s.SoundId="rbxassetid://"..KILL_SOUNDS[math.random(#KILL_SOUNDS)]
    s:Play(); Debris:AddItem(s,6)
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(c)
        task.wait(1)
        local hum=c:WaitForChild("Humanoid",10)
        if hum then
            local lastHealth=hum.Health
            hum.HealthChanged:Connect(function(new)
                if new<lastHealth-0.05 and (S.SA.Enabled or S.Rage.Enabled) then
                    local isTarget=F.targetPart and F.targetPart.Parent==c
                    if isTarget or (F.lastConfirmedShotPlayer==p and clock()-F.lastConfirmedShotTime<3) then
                        if S.DamageFX.Enabled then F.spawnDamageFX(c.HumanoidRootPart.Position,1) end
                        if S.KillSound.Enabled and new<=0 then F.playKillSound() end
                    end
                end
                lastHealth=new
            end)
        end
    end)
end)

-- ===== UNLOAD =====
function F.unload()
    S.Unloaded=true
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() fovGui:Destroy() end)
    pcall(function() espGui:Destroy() end)
    for _,c in pairs(F.conns) do pcall(function() c:Disconnect() end) end
    F.conns={}
    pcall(F.RestoreAllHitboxes)
    pcall(F.disableCopterFly)
    for _,l in ipairs(chLines) do pcall(function() l:Remove() end) end
    for _,tr in ipairs(tracers) do pcall(function() tr.p:Destroy() end) end
end
getgenv().__VOMAGLA_UNLOAD=F.unload

print("[VOMAGLA] Loaded. UI: VomaglaNyxon")
