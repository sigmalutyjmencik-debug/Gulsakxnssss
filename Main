-- CHARACTER TRACKING
F.char = LP.Character
F.hum = F.char and F.char:FindFirstChildWhichIsA("Humanoid")

local function updChar(c)
    F.char = c
    F.hum = nil
    if c then
        task.spawn(function()
            local h = c:WaitForChild("Humanoid", 10)
            if h and F.char == c then
                F.hum = h
            end
        end)
    end
end

LP.CharacterAdded:Connect(updChar)
LP.CharacterRemoving:Connect(function()
    F.char = nil
