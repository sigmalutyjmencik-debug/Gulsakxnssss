        Ft = "rbxassetid://99674108178510",
        Lf = "rbxassetid://78775818685659",
        Rt = "rbxassetid://117864739442861",
        Up = "rbxassetid://94326041205929",
    },
}

F.applySkybox = function(name)
    local sky = Light:FindFirstChildOfClass("Sky")
    if name == "Default" then
        if sky then sky:Destroy() end
        return
    end
    local d = SkyBoxes[name]
    if not d then return end
    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = Light
    end
    sky.SkyboxBk = d.Bk or ""
    sky.SkyboxDn = d.Dn or d.Bk or ""
    sky.SkyboxFt = d.Ft or d.Bk or ""
    sky.SkyboxLf = d.Lf or d.Bk or ""
    sky.SkyboxRt = d.Rt or d.Bk or ""
    sky.SkyboxUp = d.Up or d.Bk or ""
end

-- X-RAY
local xrayCache = {}
local xrayKeywords = { "TwigWall", "SoloTwigFrame", "TrigTwigRoof", "TwigFrame", "TwigWindow", "TwigRoof" }

F.setXray = function(on)
    if on then
        task.spawn(function()
            for _, o in ipairs(WS:GetDescendants()) do
                if o:IsA("BasePart") or o:IsA("MeshPart") then
                    for _, k in ipairs(xrayKeywords) do
                        if string.find(o.Name, k) then
                            if not xrayCache[o] then
                                xrayCache[o] = o.Transparency
                            end
                            o.Transparency = S.XRay_Transparency
                            break
                        end
                    end
                end
            end
        end)
    else
        for o, orig in pairs(xrayCache) do
            if o and o.Parent then
                o.Transparency = orig
            end
        end
        xrayCache = {}
    end
end

