end

Players.PlayerRemoving:Connect(function(plr)
    local d = espCache[plr]
    if d then
        pcall(function()
            if d.Chams then d.Chams:Destroy() end
            d.Holder:Destroy()
        end)
        espCache[plr] = nil
    end
end)

local function getWeaponName(plr)
    local ch = plr.Character
    if ch then
        for _, c in ipairs(ch:GetChildren()) do
            if c:IsA("Tool") then
                return c.Name
            end
        end
    end
    return "none"
end

F.updateESP = function()
    if S.Unloaded then return end
    if not S.ESP_Enabled then
        for _, d in pairs(espCache) do
            d.Holder.Visible = false
        end
        return
    end
    local c = WS.CurrentCamera
    if not c then return end
    local myRoot = F.char and F.char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for plr in next, F.playerCache do
        if not F.isTeammate(plr) then
            local d = espCache[plr]
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChildWhichIsA("Humanoid")
            if ch and hrp and hum and hum.Health > 0 then
                local distance = (myRoot.Position - hrp.Position).Magnitude
                if distance <= S.ESP_MaxDistance then
                    local sp, onScreen = c:WorldToViewportPoint(hrp.Position)
                    if sp.Z > 1 and onScreen then
                        if not d then
                            mkESP(plr)
                            d = espCache[plr]
                        end
                        local vp = c.ViewportSize
                        local proj = vp.Y / (2 * math.tan(rad(c.FieldOfView) * 0.5))
                        local h = clamp((7 * proj) / sp.Z, 5, vp.Y * 0.82)
                        local w = math.max(h * 0.6, 3)
                        d.Holder.Visible = true
                        d.Holder.Position = UDim2.fromOffset(floor(sp.X - w * 0.5), floor(sp.Y - h * 0.52))
                        d.Holder.Size = UDim2.fromOffset(floor(w), floor(h))
                        d.Box.Visible = S.ESP_Box
                        d.Inline.Color = S.ESP_Color
                        d.Name.Visible = S.ESP_Name
                        d.Name.Text = plr.DisplayName
                        d.Dist.Visible = S.ESP_Distance
                        d.Dist.Text = floor(distance) .. "m"
                        d.Weapon.Visible = S.ESP_Weapon
                        d.Weapon.Text = getWeaponName(plr)
                        d.HpBg.Visible = S.ESP_HealthBar
                        if S.ESP_HealthBar then
                            local hpRatio = clamp(hum.Health / hum.MaxHealth, 0, 1)
                            d.Hp.Size = UDim2.new(1, 0, hpRatio, 0)
                        end
                        if S.ESP_Chams then
                            if not d.Chams or not d.Chams.Parent then
                                local hl = Instance.new("Highlight")
                                hl.Adornee = ch
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.FillTransparency = 1 - clamp(S.ESP_ChamsStrength / 100, 0, 1)
                                hl.FillColor = S.ESP_ChamsColor
                                hl.OutlineColor = S.ESP_ChamsColor
                                hl.OutlineTransparency = 0.3
                                hl.Parent = ch
                                d.Chams = hl
                            else
                                d.Chams.FillColor = S.ESP_ChamsColor
                                d.Chams.OutlineColor = S.ESP_ChamsColor
                                d.Chams.FillTransparency = 1 - clamp(S.ESP_ChamsStrength / 100, 0, 1)
                            end
                        elseif d.Chams then
                            d.Chams:Destroy()
                            d.Chams = nil
                        end
                    else
                        if d then d.Holder.Visible = false end
                    end
                else
                    if d then d.Holder.Visible = false end
                end
            else
                if d then d.Holder.Visible = false end
            end
        end
    end
end

-- TARGET HUD
local thGui = Instance.new("ScreenGui")
thGui.Name = "EpsteinTH"
thGui.ResetOnSpawn = false
thGui.IgnoreGuiInset = true
thGui.DisplayOrder = 9997
pcall(function() thGui.Parent = CoreGui end)

local thFrame = Instance.new("Frame")
thFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
thFrame.BackgroundTransparency = 0.15
thFrame.BorderSizePixel = 0
thFrame.Visible = false
thFrame.Parent = thGui

local thCorner = Instance.new("UICorner")
thCorner.CornerRadius = UDim.new(0, 6)
thCorner.Parent = thFrame

local thStroke = Instance.new("UIStroke")
thStroke.Color = ACCENT
thStroke.Thickness = 1
thStroke.Parent = thFrame

local thName = Instance.new("TextLabel")
thName.Position = UDim2.new(0, 10, 0, 5)
thName.Size = UDim2.new(1, -20, 0, 24)
thName.BackgroundTransparency = 1
thName.TextColor3 = WHITE
thName.Font = Enum.Font.Code
thName.TextSize = 16
thName.TextXAlignment = Enum.TextXAlignment.Left
thName.Parent = thFrame

local thHpBg = Instance.new("Frame")
thHpBg.Position = UDim2.new(0, 10, 1, -18)
thHpBg.Size = UDim2.new(1, -20, 0, 8)
thHpBg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
thHpBg.BorderSizePixel = 0
thHpBg.Parent = thFrame

local thHp = Instance.new("Frame")
thHp.Size = UDim2.new(1, 0, 1, 0)
thHp.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
thHp.BorderSizePixel = 0
thHp.Parent = thHpBg

F.updateTargetHUD = function()
    if S.Unloaded then return end
    if not S.TargetHUD_Enabled or not F.targetPart or not F.targetPart.Parent then
        thFrame.Visible = false
        return
    end
    local ch = F.targetPart.Parent
    local hum = ch:FindFirstChildWhichIsA("Humanoid")
    if not hum or hum.Health <= 0 then
        thFrame.Visible = false
        return
    end
    local plr = Players:GetPlayerFromCharacter(ch)
    local c = WS.CurrentCamera
    if not c then return end
    thFrame.Visible = true
    local vp = c.ViewportSize
    local size = vp.X * 0.15 * (1 + S.TargetHUD_Size / 100)
    thFrame.Size = UDim2.fromOffset(size, size * 0.35)
    thFrame.AnchorPoint = V2(0.5, 0.5)
    thFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    if plr then
        thName.Text = plr.DisplayName
    else
        thName.Text = ch.Name
    end
    local hpRatio = clamp(hum.Health / hum.MaxHealth, 0, 1)
    thHp.Size = UDim2.new(hpRatio, 0, 1, 0)
end

-- HITBOX
local enlarged = {}

F.RestoreAllHitboxes = function()
    for obj, orig in pairs(enlarged) do
        if obj and obj.Parent then
            obj.Size = orig.Size
            obj.Color = orig.Color
            obj.Transparency = orig.Transparency
            obj.Material = orig.Material
        end
    end
    enlarged = {}
end

F.UpdateAllHitboxes = function()
    for obj, orig in pairs(enlarged) do
        if obj and obj.Parent then
            if S.Hitbox_Mode == "3D" then
                obj.Size = orig.Size * S.Hitbox_Size
            else
                obj.Size = V3(orig.Size.X * S.Hitbox_Size, orig.Size.Y, orig.Size.Z * S.Hitbox_Size)
            end
            obj.Color = S.Hitbox_Color
            obj.Transparency = S.Hitbox_Transparency
        end
    end
end

F.ApplyHitboxVisuals = function()
    for obj in pairs(enlarged) do
        if obj and obj.Parent then
            obj.Transparency = S.Hitbox_Transparency
            obj.Color = S.Hitbox_Color
        end
    end
end

F.InitHitboxWatchers = function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hitbox = p.Character:FindFirstChild("HeadHitbox")
            if hitbox and not enlarged[hitbox] then
                enlarged[hitbox] = {
                    Size = hitbox.Size,
                    Color = hitbox.Color,
                    Transparency = hitbox.Transparency,
                    Material = hitbox.Material,
                }
                if S.Hitbox_Enabled then
                    if S.Hitbox_Mode == "3D" then
                        hitbox.Size = hitbox.Size * S.Hitbox_Size
                    else
                        hitbox.Size = V3(hitbox.Size.X * S.Hitbox_Size, hitbox.Size.Y, hitbox.Size.Z * S.Hitbox_Size)
                    end
                    hitbox.Color = S.Hitbox_Color
                    hitbox.Transparency = S.Hitbox_Transparency
                    hitbox.Material = Enum.Material.Neon
                end
            end
        end
    end
end

-- FLIES
F.toggleVelocityFly = function(on)
    S.VelocityFly_Enabled = on
    if on then
        local hum = F.hum
        if hum and hum.SeatPart then
            hum.AutoRotate = false
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = V3(1, 1, 1) * 9e9
            bv.Velocity = V3(0, 0, 0)
            bv.Parent = hum.SeatPart
            S.VelocityFly_bodyVel = bv
            local bg = Instance.new("BodyGyro")
            bg.MaxTorque = V3(1, 1, 1) * 9e9
            bg.P = 9000
            bg.CFrame = hum.SeatPart.CFrame
            bg.Parent = hum.SeatPart
            S.VelocityFly_bodyGyro = bg
        end
    else
        if S.VelocityFly_bodyVel then
            pcall(function() S.VelocityFly_bodyVel:Destroy() end)
            S.VelocityFly_bodyVel = nil
        end
        if S.VelocityFly_bodyGyro then
            pcall(function() S.VelocityFly_bodyGyro:Destroy() end)
            S.VelocityFly_bodyGyro = nil
        end
        local hum = F.hum
        if hum then
            hum.AutoRotate = true
        end
    end
end

F.velocityFlyStep = function(hum)
    if not hum or not hum.SeatPart then return end
    hum.Sit = true
    local cf = WS.CurrentCamera.CFrame
    local md = hum.MoveDirection
    local mv = V3(0, 0, 0)
    if md.Magnitude > 0 then
        mv = md.Unit
    end
    local vert = 0
    if UIS:IsKeyDown(Enum.KeyCode.Space) then vert = 1 end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vert = -1 end
    if S.VelocityFly_bodyVel and S.VelocityFly_bodyVel.Parent then
        if mv.Magnitude > 0 or vert ~= 0 then
            S.VelocityFly_bodyVel.Velocity = (mv + V3(0, vert, 0)).Unit * S.VelocityFly_Speed
        else
            S.VelocityFly_bodyVel.Velocity = V3(0, 0, 0)
        end
    end
    if S.VelocityFly_bodyGyro and S.VelocityFly_bodyGyro.Parent then
        S.VelocityFly_bodyGyro.CFrame = cf
    end
end

F.teleportFlyStep = function(dt, hum)
    if not hum then return end
    local hrp = F.char and F.char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local cf = WS.CurrentCamera.CFrame
    local md = hum.MoveDirection
    local moveVec = cf.LookVector * -md.Z + cf.RightVector * md.X
    local vert = 0
    if UIS:IsKeyDown(Enum.KeyCode.Space) then vert = 1 end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vert = -1 end
    local finalVec = moveVec + V3(0, vert, 0)
    if finalVec.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + finalVec.Unit * S.TeleportFly_Speed * dt * 30
    end
end

F.toggleCopterFly = function(on)
    S.CopterFly_Enabled = on
    if on then
        local hum = F.hum
        if hum and hum.SeatPart then
            hum.AutoRotate = false
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = V3(1, 1, 1) * 9e9
            bv.Velocity = V3(0, 0, 0)
            bv.Parent = hum.SeatPart
            S.CopterFly_bodyVel = bv
            local bg = Instance.new("BodyGyro")
            bg.MaxTorque = V3(1, 1, 1) * 9e9
            bg.P = 9000
            bg.CFrame = hum.SeatPart.CFrame
            bg.Parent = hum.SeatPart
            S.CopterFly_bodyGyro = bg
        end
    else
        if S.CopterFly_bodyVel then
            pcall(function() S.CopterFly_bodyVel:Destroy() end)
            S.CopterFly_bodyVel = nil
        end
        if S.CopterFly_bodyGyro then
            pcall(function() S.CopterFly_bodyGyro:Destroy() end)
            S.CopterFly_bodyGyro = nil
        end
        local hum = F.hum
        if hum then
            hum.AutoRotate = true
        end
    end
end

F.copterFlyStep = function(hum)
    if not hum or not hum.SeatPart then return end
    hum.Sit = true
    local cf = WS.CurrentCamera.CFrame
    local mv = V3(0, 0, 0)
    if UIS:IsKeyDown(Enum.KeyCode.W) then mv = mv + cf.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then mv = mv - cf.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then mv = mv + cf.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then mv = mv - cf.RightVector end
    local vert = 0
    if UIS:IsKeyDown(Enum.KeyCode.Space) then vert = 1 end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vert = -1 end
    if S.CopterFly_bodyVel and S.CopterFly_bodyVel.Parent then
        if mv.Magnitude > 0 or vert ~= 0 then
            S.CopterFly_bodyVel.Velocity = (mv + V3(0, vert, 0)).Unit * S.CopterFly_Speed
        else
            S.CopterFly_bodyVel.Velocity = V3(0, 0, 0)
        end
    end
    if S.CopterFly_bodyGyro and S.CopterFly_bodyGyro.Parent then
        S.CopterFly_bodyGyro.CFrame = cf
    end
end

-- HEAD TILT
local headTiltNeck = nil

F.updateHeadTilt = function()
    if not S.HeadTilt_Enabled then
        if headTiltNeck and headTiltNeck.Parent then
            pcall(function() headTiltNeck.Transform = CF.new() end)
        end
        headTiltNeck = nil
        return
    end
    local ch = F.char
    if not ch then return end
    local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
    if not torso then return end
    local neck = torso:FindFirstChild("Neck")
    if not neck or not neck:IsA("Motor6D") then return end
    headTiltNeck = neck
    neck.Transform = CFrame.Angles(rad(S.HeadTilt_Pitch), 0, 0)
end

-- MAIN LOOPS
local lastGigaJump = 0
local speedRay = RaycastParams.new()
speedRay.FilterType = Enum.RaycastFilterType.Exclude
speedRay.IgnoreWater = true

RunService.Heartbeat:Connect(function(dt)
    if S.Unloaded then return end
    F.updateTracers()
    F.processHitMarkers()

    local ch = F.char
    if not ch then return end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    local hum = F.hum
    if not hrp or not hum or hum.Health <= 0 then return end

    if S.Speed_Enabled then
        local md = hum.MoveDirection
        if md.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = V3(md.X * S.Speed_Value, hrp.AssemblyLinearVelocity.Y, md.Z * S.Speed_Value)
        end
    end

    if S.CopterSpeed_Enabled and hum.Sit then
        local md = hum.MoveDirection
        if md.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = V3(md.X * S.CopterSpeed_Value, hrp.AssemblyLinearVelocity.Y, md.Z * S.CopterSpeed_Value)
        end
    end

    if S.WaterSpeed_Enabled then
        if hum:GetState() == Enum.HumanoidStateType.Swimming then
            local bv = hrp:FindFirstChild("WSV")
            if not bv then
                bv = Instance.new("BodyVelocity", hrp)
                bv.Name = "WSV"
                bv.MaxForce = V3(1e5, 1e5, 1e5)
            end
            bv.Velocity = hum.MoveDirection * S.WaterSpeed_Value
        else
            local bv = hrp:FindFirstChild("WSV")
            if bv then bv:Destroy() end
        end
    end

    if S.Spider_Enabled then
        if UIS:IsKeyDown(Enum.KeyCode.W) then
            speedRay.FilterDescendantsInstances = { ch }
            local r = WS:Raycast(hrp.Position, hrp.CFrame.LookVector * 2.5, speedRay)
            if r and r.Instance and r.Instance:IsA("BasePart") and r.Instance.CanCollide then
                if abs(r.Normal.Y) < 0.5 then
                    hrp.AssemblyLinearVelocity = V3(hrp.AssemblyLinearVelocity.X, S.Spider_Speed, hrp.AssemblyLinearVelocity.Z)
                end
            end
        end
    end

    if S.InfJump_Enabled then
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            local st = hum:GetState()
            if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            else
                hrp.AssemblyLinearVelocity = V3(hrp.AssemblyLinearVelocity.X, 50, hrp.AssemblyLinearVelocity.Z)
            end
        end
    end

    if S.GigaJump_Enabled then
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            local now = tick()
            if now - lastGigaJump > 0.3 then
                lastGigaJump = now
                hrp.AssemblyLinearVelocity = V3(hrp.AssemblyLinearVelocity.X, S.GigaJump_Power, hrp.AssemblyLinearVelocity.Z)
            end
        end
    end

    if S.NoFall_Enabled then
        if hrp.AssemblyLinearVelocity.Y < -55 then
            speedRay.FilterDescendantsInstances = { ch }
            local r = WS:Raycast(hrp.Position, V3(0, -10, 0), speedRay)
            if r then
                hrp.AssemblyLinearVelocity = V3(hrp.AssemblyLinearVelocity.X, -2, hrp.AssemblyLinearVelocity.Z)
            end
        end
    end

    if S.VelocityFly_Enabled then
        F.velocityFlyStep(hum)
    end

    if S.TeleportFly_Enabled then
        F.teleportFlyStep(dt, hum)
    end

    if S.CopterFly_Enabled then
        F.copterFlyStep(hum)
    end

    if S.Spinner_Enabled then
        hum.AutoRotate = false
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, rad(S.Spinner_Speed * dt), 0)
    end
end)

local nTarget = 0
local nESP = 0
local nTH = 0

RunService.RenderStepped:Connect(function(dt)
    if S.Unloaded then return end
    local c = WS.CurrentCamera
    if not c then return end
    local now = tick()

    if S.ThirdPerson_Enabled then
        local hrp = F.char and F.char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local focus = hrp.Position + V3(0, S.ThirdPerson_Height, 0)
            local look = c.CFrame.LookVector
            local desiredPos = focus - look * S.ThirdPerson_Distance
            c.CFrame = CFrame.lookAt(desiredPos, focus)
        end
    end

    if S.FOVCam_Enabled then
        c.FieldOfView = S.FOVCam_Value
    end

    if S.SA_Enabled then
        if now >= nTarget then
            nTarget = now + 0.01
            local part, pos = F.getClosestSA()
            F.targetPart = part
            F.targetPos = pos
        end
    else
        F.targetPart = nil
        F.targetPos = nil
    end

    if F.targetPos then
        local sp = c:WorldToViewportPoint(F.targetPos)
        if sp then
            F.aimScreenPos = V2(sp.X, sp.Y)
        end
    else
        F.aimScreenPos = nil
    end

    if saLine then
        if S.SA_Enabled and S.SA_TargetLine and F.aimScreenPos then
            local vp = c.ViewportSize
            saLine.Visible = true
            saLine.Color = S.SAColor_Target
            saLine.From = V2(vp.X * 0.5, vp.Y * 0.5)
            saLine.To = F.aimScreenPos
        else
            saLine.Visible = false
        end
    end

    if S.SA_ShowFOV and S.SA_Enabled then
        fovFill.Visible = true
        local vp = c.ViewportSize
        fovFill.Position = UDim2.new(0, vp.X * 0.5, 0, vp.Y * 0.5)
        fovFill.Size = UDim2.new(0, S.SA_FOVRadius * 2, 0, S.SA_FOVRadius * 2)
        local col = WHITE
        if F.targetPart then
            col = S.SAColor_Target
        end
        fovFill.BackgroundColor3 = col
        fovStroke.Color = col
    else
        fovFill.Visible = false
    end

    F.updateHeadTilt()
    F.updateCrosshair(dt)

    if now >= nESP then
        nESP = now + 0.016
        F.updateESP()
    end

    if now >= nTH then
        nTH = now + 0.05
        F.updateTargetHUD()
    end
end)

-- DAMAGE TRACKING
local dmgConns = {}
local deathConns = {}
local lastHealth = {}

local function isOurDamage(plr, char)
    if F.isTeammate(plr) then return false end
    if not S.SA_Enabled then return false end
    if F.targetPart and F.targetPart.Parent == char then return true end
    return false
end

local function onDamaged(plr, char, dmg, newHealth)
    if dmg <= 0.01 then return end
    if not isOurDamage(plr, char) then return end
    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not part then return end
    if S.HL_Enabled then
        F.showHitLog(plr.DisplayName, part.Name, string.format("%.0f", dmg), string.format("%.0f", newHealth), newHealth <= 0)
    end
    if S.HM_Enabled then
        F.spawnHitMarker(part.Position, false)
    end
end

local function trackPlayer(plr)
    if plr == LP then return end
    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        local old = dmgConns[hum]
        if old then pcall(function() old:Disconnect() end) end
        lastHealth[hum] = hum.Health
        dmgConns[hum] = hum.HealthChanged:Connect(function(new)
            local prev = lastHealth[hum] or new
            lastHealth[hum] = new
            if new < prev - 0.05 then
                onDamaged(plr, char, prev - new, new)
            end
        end)
        local oldD = deathConns[hum]
        if oldD then pcall(function() oldD:Disconnect() end) end
        deathConns[hum] = hum.Died:Connect(function()
            if F.targetPart and F.targetPart.Parent == char then
                F.showKillNotify("Killed " .. plr.DisplayName)
            end
        end)
    end
    if plr.Character then
        onChar(plr.Character)
    end
    plr.CharacterAdded:Connect(onChar)
end

for _, p in ipairs(Players:GetPlayers()) do
    trackPlayer(p)
end
Players.PlayerAdded:Connect(trackPlayer)

-- DRAG
local MainDragging = false
local MainDragStart = nil
local MainStartPos = nil

TitleBar.InputBegan:Connect(function(input)
    if Locked then return end
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        MainDragging = true
        MainDragStart = input.Position
        MainStartPos = Main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    local t = input.UserInputType
    if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
        return
    end
    if MainDragging and not Locked and MainDragStart then
        local d = input.Position - MainDragStart
        Main.Position = UDim2.fromOffset(MainStartPos.X.Offset + d.X, MainStartPos.Y.Offset + d.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        MainDragging = false
    end
end)

-- TAB SWITCH
local function SelectTab(index)
    for i, page in ipairs(Pages) do
        page.Visible = (i == index)
    end
    for i, btn in ipairs(TabButtons) do
        if i == index then
            btn.TextColor3 = WHITE
        else
            btn.TextColor3 = GRAY
        end
    end
    Picker.Visible = false
end

for i, btn in ipairs(TabButtons) do
    btn.MouseButton1Click:Connect(function()
        SelectTab(i)
    end)
end

-- UNLOAD
F.unload = function()
    S.Unloaded = true
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() espGui:Destroy() end)
    pcall(function() hlGui:Destroy() end)
    pcall(function() knGui:Destroy() end)
    pcall(function() thGui:Destroy() end)
    pcall(function() fovGui:Destroy() end)
    pcall(F.RestoreAllHitboxes)
    pcall(function() F.toggleVelocityFly(false) end)
    pcall(function() F.toggleCopterFly(false) end)
    if gammaFx then
        pcall(function() gammaFx:Destroy() end)
    end
    for _, l in ipairs(chLines) do
        pcall(function() l:Remove() end)
    end
    for _, tr in ipairs(tracers) do
        pcall(function() tr.p:Destroy() end)
    end
end

getgenv().__EPSTEIN_UNLOAD = F.unload

SelectTab(1)
defer(function() CenterMain() end)

print("[Epstein Hub] Loaded")
