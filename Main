    if p ~= LP then
        F.playerCache[p] = true
    end
end)

Players.PlayerRemoving:Connect(function(p)
    F.playerCache[p] = nil
end)

F.isTeammate = function(player)
    if not S.Team_Enabled then return false end
    if not player or player == LP then return false end
    if S.Teammates[player.UserId] then return true end
    if S.WhiteList[player.UserId] then return true end
    return false
end

