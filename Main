local function BuildColumns(page)
    local area = Instance.new("Frame")
    area.Position = UDim2.fromScale(0.008, 0.018)
    area.Size = UDim2.new(0.984, 0, 0.964, 0)
    area.BackgroundTransparency = 1
    area.Parent = page

    local left = Instance.new("ScrollingFrame")
    left.Position = UDim2.fromScale(0, 0)
    left.Size = UDim2.new(0.485, 0, 1, 0)
    left.BackgroundColor3 = PANEL
    left.BorderSizePixel = 0
    left.ScrollBarThickness = 4
    left.ScrollBarImageColor3 = ACCENT
    left.CanvasSize = UDim2.new(0, 0, 0, 0)
    left.AutomaticCanvasSize = Enum.AutomaticSize.Y
    left.Parent = area
    MakeStroke(left, 1)

    local leftLayout = Instance.new("UIListLayout")
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Padding = UDim.new(0, 2)
    leftLayout.Parent = left

    local leftPad = Instance.new("UIPadding")
    leftPad.PaddingLeft = UDim.new(0, 4)
    leftPad.PaddingRight = UDim.new(0, 4)
    leftPad.PaddingTop = UDim.new(0, 4)
    leftPad.PaddingBottom = UDim.new(0, 4)
    leftPad.Parent = left

    local right = Instance.new("ScrollingFrame")
    right.Position = UDim2.fromScale(0.512, 0)
    right.Size = UDim2.new(0.485, 0, 1, 0)
    right.BackgroundColor3 = PANEL
    right.BorderSizePixel = 0
    right.ScrollBarThickness = 4
    right.ScrollBarImageColor3 = ACCENT
    right.CanvasSize = UDim2.new(0, 0, 0, 0)
    right.AutomaticCanvasSize = Enum.AutomaticSize.Y
    right.Parent = area
    MakeStroke(right, 1)

    local rightLayout = Instance.new("UIListLayout")
    rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightLayout.Padding = UDim.new(0, 2)
    rightLayout.Parent = right

    local rightPad = Instance.new("UIPadding")
    rightPad.PaddingLeft = UDim.new(0, 4)
    rightPad.PaddingRight = UDim.new(0, 4)
    rightPad.PaddingTop = UDim.new(0, 4)
    rightPad.PaddingBottom = UDim.new(0, 4)
    rightPad.Parent = right

    return left, right
end

