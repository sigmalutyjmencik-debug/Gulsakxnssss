-- SCREEN GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "EpsteinHub"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = CoreGui

local function MakeStroke(parent, thickness)
    local s = Instance.new("UIStroke")
    s.Color = ACCENT
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function MakeText(parent, value, pos, size, tsize, color)
    local l = Instance.new("TextLabel")
    l.Position = pos
    l.Size = size
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Text = value
    l.TextColor3 = color or WHITE
    l.Font = Enum.Font.Code
    l.TextSize = tsize or 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = parent
    return l
end

local function MakeLine(parent, y)
    local l = Instance.new("Frame")
    l.Position = UDim2.new(0, 0, 0, y)
    l.Size = UDim2.new(1, 0, 0, 1)
    l.BackgroundColor3 = ACCENT
    l.BorderSizePixel = 0
    l.Parent = parent
    return l
end

