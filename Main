PC.BackgroundTransparency=1; PC.Parent=Main
local function mkPage()
    local sc=Instance.new("ScrollingFrame"); sc.Size=UDim2.new(1,-8,1,-8); sc.Position=UDim2.new(0,4,0,4)
    sc.BackgroundColor3=PANEL; sc.BorderSizePixel=0; sc.ScrollBarThickness=4
    sc.ScrollBarImageColor3=BLUE; sc.CanvasSize=UDim2.new(0,0,0,0); sc.Visible=false; sc.Parent=PC
    stroke(sc,PIXEL,1)
    local l=Instance.new("UIListLayout"); l.SortOrder=Enum.SortOrder.LayoutOrder; l.Padding=UDim.new(0,2); l.Parent=sc
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sc.CanvasSize=UDim2.new(0,0,0,l.AbsoluteContentSize.Y+8)
    end)
    return sc
end
for i=1,4 do pages[i]=mkPage() end
local function sw(i) for k,p in ipairs(pages) do p.Visible=(k==i) end; tl.Position=UDim2.new((i-1)*0.25,0,1,-2) end
sw(1)
for i,b in ipairs(btns) do b.MouseButton1Click:Connect(function() sw(i) end) end
