-- TRACERS
local tracers = {}

F.createTrace = function(a, b)
    if S.Unloaded then return end
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.Transparency = 1
    p.Size = V3(0.1, 0.1, 0.1)
    p.Parent = WS

    local a0 = Instance.new("Attachment", p)
    local a1 = Instance.new("Attachment", p)
    a0.WorldPosition = a
    a1.WorldPosition = b

    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Texture = S.Tracers_Texture
    beam.TextureLength = 2
    beam.TextureSpeed = 2
    beam.Color = ColorSequence.new(S.Tracers_Color)
    beam.Width0 = S.Tracers_Width
    beam.Width1 = S.Tracers_Width
    beam.Transparency = NumberSequence.new(0)
    beam.Parent = p

    table.insert(tracers, { p = p, t = tick() })
end

F.updateTracers = function()
    for i = #tracers, 1, -1 do
        local tr = tracers[i]
        if not tr.p or not tr.p.Parent then
            table.remove(tracers, i)
        elseif tick() - tr.t > S.Tracers_LifeTime then
            pcall(function() tr.p:Destroy() end)
            table.remove(tracers, i)
        end
    end
end

-- HIT MARKER
local hmQueue = {}
local hmDirs = { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }

F.spawnHitMarker = function(pos, isKill)
    if not hasDrawing then return end
    local lines = {}
    for i = 1, 4 do
        local l = Drawing.new("Line")
        l.Visible = false
        l.Thickness = S.HM_Thickness
        table.insert(lines, l)
    end
    table.insert(hmQueue, { pos = pos, born = tick(), isKill = isKill, lines = lines })
end

F.processHitMarkers = function()
    if not hasDrawing then return end
    if #hmQueue == 0 then return end
    local c = WS.CurrentCamera
    if not c then return end
    local now = tick()
    for i = #hmQueue, 1, -1 do
        local m = hmQueue[i]
        local age = now - m.born
        if age > S.HM_Duration then
            for _, l in ipairs(m.lines) do
                pcall(function() l:Remove() end)
            end
            table.remove(hmQueue, i)
        elseif not S.HM_Enabled then
            for _, l in ipairs(m.lines) do
                l.Visible = false
            end
        else
            local sp, vis = c:WorldToViewportPoint(m.pos)
            local alpha = 1 - (age / S.HM_Duration)
            local col = S.HM_Color
            if m.isKill then
                col = S.HM_KillColor
            end
            for j = 1, 4 do
                local l = m.lines[j]
                local d = hmDirs[j]
                l.Visible = vis
                l.Transparency = alpha
                l.Color = col
                l.Thickness = S.HM_Thickness
                l.From = V2(sp.X + d[1] * S.HM_Size * 0.3, sp.Y + d[2] * S.HM_Size * 0.3)
                l.To = V2(sp.X + d[1] * S.HM_Size, sp.Y + d[2] * S.HM_Size)
            end
        end
    end
end

-- CROSSHAIR
local chLines = {}
if hasDrawing then
    for i = 1, 4 do
        local l = Drawing.new("Line")
        l.Visible = false
        l.Thickness = S.CH_Thickness
        chLines[i] = l
    end
end

local chElapsed = 0
local chRot = 0

F.updateCrosshair = function(dt)
    if not hasDrawing then return end
    if not S.CH_Enabled or S.Unloaded then
        for _, l in ipairs(chLines) do
            l.Visible = false
        end
        return
    end
    local c = WS.CurrentCamera
    if not c then return end
    local vp = c.ViewportSize
    local cx = vp.X * 0.5
    local cy = vp.Y * 0.5
    chElapsed = chElapsed + dt
    chRot = (chRot + dt * S.CH_RotationSpeed) % 360
    local col = S.CH_Color
    if S.CH_Rainbow then
        col = Color3.fromHSV((chElapsed * 0.5) % 1, 1, 1)
    end
    local gap = S.CH_Gap
    if S.CH_Pulse then
        gap = gap + math.sin(chElapsed * S.CH_PulseSpeed) * math.max(S.CH_Gap * 0.4, 2)
    end
    for i = 0, 3 do
        local l = chLines[i + 1]
        local ang = rad(chRot + i * 90)
        local dx = math.cos(ang)
        local dy = math.sin(ang)
        l.Visible = true
        l.Color = col
        l.Thickness = S.CH_Thickness
        l.From = V2(cx + dx * gap, cy + dy * gap)
        l.To = V2(cx + dx * (gap + S.CH_Length), cy + dy * (gap + S.CH_Length))
    end
end

