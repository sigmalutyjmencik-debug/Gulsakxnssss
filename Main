local ScreenGui=Instance.new("ScreenGui")
ScreenGui.Name="VomaglaNyxon"; ScreenGui.ResetOnSpawn=false
pcall(function() ScreenGui.Parent=CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent=LP:WaitForChild("PlayerGui") end

local Main=Instance.new("Frame")
Main.Size=UDim2.new(0,500,0,540); Main.Position=UDim2.new(0.5,-250,0.5,-270)
Main.BackgroundColor3=BG; Main.BorderSizePixel=0; Main.ClipsDescendants=true; Main.Parent=ScreenGui
stroke(Main,BLUE,1.5)

local TB=Instance.new("Frame"); TB.Size=UDim2.new(1,0,0,28); TB.BackgroundColor3=BG
TB.BorderSizePixel=0; TB.Parent=Main
mkLabel(TB,"VOMAGLA  |  Nyxon Edition",8,0,400,28,13,WHITE)

local dragging,dragStart,startPos=false,nil,nil
TB.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        dragging=true; dragStart=i.Position; startPos=Main.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
        local d=i.Position-dragStart
        Main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
end)
div(Main,28)

-- ===== CONTROLS =====
local C={}; C.__index=C
function C:Section(t)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,26); r.BackgroundTransparency=1; r.Parent=self.H
    mkLabel(r,t,6,4,440,20,14,BLUE); div(r,24,Color3.fromRGB(60,60,70))
end
function C:Label(t)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,18); r.BackgroundTransparency=1; r.Parent=self.H
    mkLabel(r,t,6,0,440,18,12,GRAY)
end
function C:Toggle(name,def,cb)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,24); r.BackgroundTransparency=1; r.Parent=self.H
    local box=Instance.new("Frame"); box.Position=UDim2.new(0,6,0,4); box.Size=UDim2.new(0,16,0,16)
    box.BackgroundColor3=CHKBG; box.BorderSizePixel=0; box.Parent=r; stroke(box,Color3.fromRGB(80,80,90),1)
    local ck=Instance.new("Frame"); ck.Position=UDim2.new(0,3,0,3); ck.Size=UDim2.new(0,10,0,10)
    ck.BackgroundColor3=BLUE; ck.BorderSizePixel=0; ck.Visible=def or false; ck.Parent=box
    mkLabel(r,name,30,0,400,24,13,WHITE)
    local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,1,0); b.BackgroundTransparency=1; b.Text=""; b.Parent=r
    local st=def or false
    b.MouseButton1Click:Connect(function() st=not st; ck.Visible=st; if cb then pcall(cb,st) end end)
    return {Set=function(v) st=v; ck.Visible=v; if cb then pcall(cb,v) end end}
end
function C:Slider(name,min,max,def,round,cb)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,40); r.BackgroundTransparency=1; r.Parent=self.H
    mkLabel(r,name,6,0,320,16,13,WHITE)
    local vl=mkLabel(r,tostring(def),320,0,90,16,13,BLUE); vl.TextXAlignment=Enum.TextXAlignment.Right
    local bar=Instance.new("Frame"); bar.Position=UDim2.new(0,6,0,22); bar.Size=UDim2.new(1,-12,0,8)
    bar.BackgroundColor3=BARBG; bar.BorderSizePixel=0; bar.Parent=r; stroke(bar,BLUE,1)
    local fl=Instance.new("Frame"); fl.Size=UDim2.new((def-min)/(max-min),0,1,0)
    fl.BackgroundColor3=BARFILL; fl.BorderSizePixel=0; fl.Parent=bar
    local dr=false
    local function upd(i)
        local rel=clamp((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local v=min+(max-min)*rel
        if round then local m=10^round; v=floor(v*m+0.5)/m end
        fl.Size=UDim2.new(rel,0,1,0); vl.Text=tostring(v)
        if cb then pcall(cb,v) end
    end
    local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,1,0); b.BackgroundTransparency=1; b.Text=""; b.Parent=r
    b.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=true; upd(i) end end)
    UIS.InputChanged:Connect(function(i) if dr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=false end end)
end
function C:Dropdown(name,vals,def,cb)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,52); r.BackgroundTransparency=1; r.ClipsDescendants=false; r.Parent=self.H
    mkLabel(r,name,6,0,320,16,13,WHITE)
    local box=Instance.new("Frame"); box.Position=UDim2.new(0,6,0,20); box.Size=UDim2.new(1,-12,0,24)
    box.BackgroundColor3=DROPBG; box.BorderSizePixel=0; box.Parent=r; stroke(box,BLUE,1)
    local cur=def or vals[1]
    local tx=mkLabel(box,tostring(cur),6,0,260,24,13,WHITE)
    local ar=mkLabel(box,"v",0,0,0,24,11,WHITE); ar.Position=UDim2.new(1,-20,0,0); ar.Size=UDim2.new(0,16,1,0)
    local lf=Instance.new("Frame"); lf.Position=UDim2.new(0,0,1,2); lf.Size=UDim2.new(1,0,0,#vals*22)
    lf.BackgroundColor3=DROPBG; lf.BorderSizePixel=0; lf.Visible=false; lf.ZIndex=20; lf.Parent=box; stroke(lf,BLUE,1)
    for i,v in ipairs(vals) do
        local o=Instance.new("TextButton"); o.Size=UDim2.new(1,0,0,22); o.Position=UDim2.new(0,0,0,(i-1)*22)
        o.BackgroundTransparency=1; o.Text=tostring(v); o.TextColor3=WHITE; o.Font=Enum.Font.Code
        o.TextSize=12; o.TextXAlignment=Enum.TextXAlignment.Left; o.ZIndex=21; o.Parent=lf
        o.MouseButton1Click:Connect(function() cur=v; tx.Text=tostring(v); lf.Visible=false; if cb then pcall(cb,v) end end)
    end
    local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,1,0); b.BackgroundTransparency=1; b.Text=""; b.Parent=box
    b.MouseButton1Click:Connect(function() lf.Visible=not lf.Visible end)
end
function C:Keybind(name,def,cb)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,28); r.BackgroundTransparency=1; r.Parent=self.H
    mkLabel(r,name,6,0,320,28,13,WHITE)
    local b=Instance.new("TextButton"); b.Position=UDim2.new(1,-80,0,4); b.Size=UDim2.new(0,74,0,20)
    b.BackgroundColor3=DROPBG; b.Text=def or "None"; b.TextColor3=WHITE; b.Font=Enum.Font.Code
    b.TextSize=12; b.BorderSizePixel=0; b.Parent=r; stroke(b,BLUE,1)
    local ls=false; local cur=def or "None"; local st=false
    b.MouseButton1Click:Connect(function() ls=true; b.Text="..." end)
    UIS.InputBegan:Connect(function(i,gp)
        if gp then return end
        if ls and i.UserInputType==Enum.UserInputType.Keyboard then
            cur=i.KeyCode.Name; b.Text=cur; ls=false
        elseif not ls and i.KeyCode.Name==cur then
            st=not st; if cb then pcall(cb,st) end
        end
    end)
end
function C:Color(name,def,cb)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-8,0,30); r.BackgroundTransparency=1; r.Parent=self.H
    mkLabel(r,name,6,0,320,30,13,WHITE)
    local pr=Instance.new("Frame"); pr.Position=UDim2.new(1,-80,0,6); pr.Size=UDim2.new(0,72,0,18)
    pr.BackgroundColor3=def or WHITE; pr.BorderSizePixel=0; pr.Parent=r; stroke(pr,BLUE,1)
    local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,1,0); b.BackgroundTransparency=1; b.Text=""; b.Parent=pr
    local pal={Color3.new(1,1,1),Color3.new(0,0,0),Color3.fromRGB(255,50,50),Color3.fromRGB(50,255,50),Color3.fromRGB(50,150,255),Color3.fromRGB(255,255,50),Color3.fromRGB(255,50,255),Color3.fromRGB(0,255,255),Color3.fromRGB(255,140,0)}
    local i=1
    b.MouseButton1Click:Connect(function() i=i%#pal+1; pr.BackgroundColor3=pal[i]; if cb then pcall(cb,pal[i]) end end)
end

