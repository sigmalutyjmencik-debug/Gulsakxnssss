function F.refreshPlayerList()
    for _,ch in ipairs(plrScroll:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local b=Instance.new("TextButton"); b.Size=UDim2.new(1,-4,0,20); b.BackgroundTransparency=1
            b.Text=(S.Team.Teammates[p.UserId] and "[+] " or "[-] ")..p.DisplayName
            b.TextColor3=S.Team.Teammates[p.UserId] and Color3.fromRGB(0,255,0) or WHITE
            b.Font=Enum.Font.Code; b.TextSize=12; b.TextXAlignment=Enum.TextXAlignment.Left; b.Parent=plrScroll
            b.MouseButton1Click:Connect(function()
                if S.Team.Teammates[p.UserId] then S.Team.Teammates[p.UserId]=nil else S.Team.Teammates[p.UserId]=true end
                F.refreshPlayerList()
            end)
        end
    end
end
